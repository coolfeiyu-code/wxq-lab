# 依赖与构建产物
node_modules/
ui/node_modules/
dist/

# 本机数据：快照、更新日志、对局记录
data/meta/

# 密钥（DeepSeek API key 等）——绝不进仓库
data/.secrets.json

# 中间产物（可用 scripts/extract-database.mjs 重新生成）
data/raw-database.json

# 本地配置
.claude/
*.log
.DS_Store

# 个人战绩若被放到仓库内，不提交。正式位置在同步目录的「万象棋AI实战助手/user-data」。
user-data/

# 悬浮窗编译中间产物
desktop/**/bin/
desktop/**/obj/
desktop/**/publish/
